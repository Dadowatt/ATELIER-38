        "jsCode": "const articles = $input.all().map(item => {\n  const data = item.json;\n\n  return {\n    title: data.title || \"\",\n    link: data.link || \"\",\n    published: data.pubDate || data.isoDate || \"\",\n    summary: data.contentSnippet || data.description || data.content || \"\"\n  };\n});\n\nreturn [\n  {\n    json: {\n      articles: articles\n    }\n  }\n];\n"
